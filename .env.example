# =====================================================================
#  CONFIGURACIÓN DEL MONITOR DE BEBÉ TAPO C225 / C200 / C210 / C220
# =====================================================================
#  Copia este archivo y renómbralo a '.env' en la raíz del proyecto.
# =====================================================================

# 1. Dirección IP de la cámara en tu red local Wi-Fi (ejemplo: 192.168.1.50)
TAPO_IP=192.168.1.50

# 2. Cuenta de Cámara (RTSP / ONVIF)
#    Se crea fácilmente en 1 minuto dentro de la App Tapo en el teléfono:
#    Ajustes de la Cámara ⚙️ -> Ajustes Avanzados -> Cuenta de la Cámara
TAPO_STREAM_USER=tu_usuario_camara
TAPO_STREAM_PASSWORD=tu_contraseña_camara

# 3. Calidad del Stream RTSP
#    stream1 = Alta Definición HQ (2K / 1080p)
#    stream2 = Calidad Fluida LQ (640x360)
TAPO_STREAM_QUALITY=stream1
